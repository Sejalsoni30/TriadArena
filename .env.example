# Triad Arena Environment Configuration Template

# Server Port & URLs
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB URI)
# In development, if MONGODB_URI is omitted or cannot connect, the server automatically boots an in-memory/mock DB store!
MONGODB_URI=mongodb://localhost:27017/triad_arena

# Authentication (Firebase Admin SDK)
# In development, if FIREBASE_PROJECT_ID is omitted, the server enables a local mock authentication provider for instant testing.
FIREBASE_PROJECT_ID=triad-arena-demo
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-demo@triad-arena-demo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Security & CORS
JWT_SECRET=super_secret_triad_arena_session_key_2026
CORS_ORIGIN=http://localhost:5173

# Client Environment (Vite prefixed)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_FIREBASE_API_KEY=AIzaSyDemoKeyForTriadArenaViteClient
VITE_FIREBASE_AUTH_DOMAIN=triad-arena-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=triad-arena-demo
VITE_FIREBASE_STORAGE_BUCKET=triad-arena-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
